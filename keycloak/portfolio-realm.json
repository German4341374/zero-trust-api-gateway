{
  "realm": "portfolio",
  "enabled": true,
  "displayName": "Portfolio Zero Trust Demo",
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Read permitted resources" },
      { "name": "admin", "description": "Read administrative resources" }
    ]
  },
  "clients": [
    {
      "clientId": "gateway-demo",
      "name": "Local gateway demonstration client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "gateway audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "gateway-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "firstName": "Demo",
      "lastName": "Viewer",
      "email": "viewer@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant": ["acme"] },
      "credentials": [
        { "type": "password", "value": "local-demo-viewer", "temporary": false }
      ],
      "realmRoles": ["viewer"]
    },
    {
      "username": "admin",
      "firstName": "Demo",
      "lastName": "Administrator",
      "email": "admin@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant": ["acme"] },
      "credentials": [
        { "type": "password", "value": "local-demo-admin", "temporary": false }
      ],
      "realmRoles": ["viewer", "admin"]
    }
  ]
}
